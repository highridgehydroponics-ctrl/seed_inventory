# HRH Seed Inventory — standalone credentials (optional on the Pi)
#
# ON THE PI: the script reads ~/.hrh_env automatically using these key names:
#   APPSHEET_GROWTH_CONTROLS_KEY  → Growth Controls API key
#   APPSHEET_GROWTH_RECIPES_KEY   → Growth Recipes API key
#   BARK_DEVICE_KEY               → Bark iPhone push key
# No separate file is needed as long as those keys are in ~/.hrh_env.
#
# STANDALONE / OVERRIDE: save this file as ~/.hrh_seed.env (chmod 600) and
# fill in the values below.  These take precedence over ~/.hrh_env.
# Never commit this file with real values.

GC_API_KEY=V2-your-growth-controls-key-here
GR_API_KEY=V2-your-growth-recipes-key-here
BARK_KEY=your-bark-device-key-here

# App IDs are built into the script; uncomment only to override.
# GC_APP_ID=0ddb09d1-5e1c-434e-9e6e-ce46a54cd628
# GR_APP_ID=fe7f55b7-a021-4f49-a9cb-c5528e8de84e
