# HRH Seed Inventory — credentials template
# Save as ~/.hrh_seed.env and run:  chmod 600 ~/.hrh_seed.env
# Never commit this file to the repo.

# AppSheet API keys (copy from AppSheet → Manage → Integrations → API keys)
GC_API_KEY=V2-your-growth-controls-key-here
GR_API_KEY=V2-your-growth-recipes-key-here

# Bark device key (from the Bark app on your iPhone → tap the device name)
BARK_KEY=your-bark-device-key-here

# AppSheet App IDs — the defaults below are already built into the script.
# Uncomment only if you need to override them.
# GC_APP_ID=0ddb09d1-5e1c-434e-9e6e-ce46a54cd628
# GR_APP_ID=fe7f55b7-a021-4f49-a9cb-c5528e8de84e
